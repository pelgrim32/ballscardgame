{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-Z]{4}(_lock)?$/)",
        ".write": "$code.matches(/^[A-Z]{4}(_lock)?$/)",
        "json": { ".validate": "newData.isString() && newData.val().length < 200000" }
      }
    },
    "lobby": {
      ".read": true,
      "$code": {
        ".write": "$code.matches(/^[A-Z]{4}$/)",
        ".validate": "newData.hasChildren(['n', 'p', 'm', 'at'])"
      }
    },
    "chat": {
      "$code": {
        ".read": "$code.matches(/^[A-Z]{4}$/)",
        "$msg": {
          ".write": "$code.matches(/^[A-Z]{4}$/) && !data.exists()",
          ".validate": "newData.hasChildren(['id', 't', 'at']) && newData.child('t').isString() && newData.child('t').val().length <= 140"
        }
      }
    }
  }
}
